# Paste into Streamlit Community Cloud > Advanced settings > Secrets.
# Never commit a real key. Use a tool-calling model available to your account.
INSIGHTPILOT_LLM_PROVIDER = "openrouter"
OPENROUTER_API_KEY = "replace-with-your-openrouter-key"
INSIGHTPILOT_CODER_MODEL = "openai/gpt-4.1-mini"
INSIGHTPILOT_REASONING_MODEL = "openai/gpt-4.1-mini"
INSIGHTPILOT_LLM_TIMEOUT = "90"
INSIGHTPILOT_LLM_ATTEMPTS = "2"
INSIGHTPILOT_MAX_TOKENS = "2048"
